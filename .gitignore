# Local clones of independent test/compatibility libraries (own GitHub repos,
# not part of mcx-arduino-core's history)
examples/tests/GPIO_NXP_Arduino/
examples/tests/I2C_device_Arduino/
examples/tests/LCDDriver_NXP_Arduino/
examples/tests/LEDDriver_NXP_Arduino/
examples/tests/TempSensor_NXP_Arduino/

# Reference materials (NXP demos, datasheets, etc.) -- not part of this
# repo's history
ref/

# gdb-bridge ships prebuilt binaries, and the Windows one is a .exe. A
# global core.excludesFile with "*.exe" in it (a common setting) would
# otherwise drop it from the release zip silently -- a repo .gitignore
# outranks the global one, so re-include it here rather than relying on
# everyone remembering `git add -f`.
!hardware/nxp/mcx/tools/gdb-bridge/*.exe

# Editor/agent-local configuration. This repo deliberately carries no
# tool-specific settings -- .claude/launch.json slipped in once via
# `git add -A` and was removed again.
.claude/

# Python bytecode from running the scripts in .github/scripts/
__pycache__/
*.pyc
