<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.6" moduleId="W5500_Lite_Ethernet_module_mcx_arduino_core_v1">
 <version>1</version>
 <author>mcx-arduino-core</author>
 <title>W5500 Lite Ethernet module</title>
 <label>ETH</label>
 <date>2026-10-25</date>
 <tags>
  <tag>W5500</tag>
  <tag>Ethernet</tag>
  <tag>WIZnet</tag>
  <tag>SPI</tag>
 </tags>
 <properties>
  <property name="family">Ethernet module</property>
  <property name="chip">W5500</property>
  <property name="variant">Lite (2x6 pins)</property>
  <property name="supply">3.3V</property>
 </properties>
 <description>A small WIZnet W5500 Ethernet module with an RJ45 jack and two rows of six 2.54 mm pins (GND, VIN 3.3V, MOSI, MISO, SCLK, CS, RST, INT, NC). For the official Arduino Ethernet library: CS to the board's SPI chip select (D10), RST to a free pin or left to the module, INT unused. The outline is estimated from a photo, not measured.</description>
 <views>
  <iconView><layers image="icon/W5500_Lite_icon.svg"><layer layerId="icon"/></layers></iconView>
  <breadboardView><layers image="breadboard/W5500_Lite_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  <schematicView><layers image="schematic/W5500_Lite_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
  <pcbView><layers image="pcb/W5500_Lite_pcb.svg"><layer layerId="copper0"/><layer layerId="silkscreen"/><layer layerId="copper1"/></layers></pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="INT" type="male">
   <description>Interrupt output (INTn), active low</description>
   <views>
